{
  "name": "silvermoon",
  "version": "0.3.0",
  "description": "The project spirit that checks repository state and answers what's next.",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "bin": {
    "silvermoon": "bin/silvermoon.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./agents/copilot": {
      "types": "./src/business/agent-copilot.d.ts",
      "default": "./src/business/agent-copilot.js"
    },
    "./agents/project-runtime": {
      "types": "./src/business/agent-project-runtime.d.ts",
      "default": "./src/business/agent-project-runtime.js"
    }
  },
  "files": [
    "bin",
    "docs",
    "skills/silvermoon",
    "src",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "schema"
  ],
  "scripts": {
    "silvermoon": "node bin/silvermoon.js",
    "check": "node bin/run-checks.mjs",
    "check:sanity": "node bin/run-checks.mjs --tier sanity",
    "check:commit": "node bin/run-checks.mjs --tier commit",
    "check:release": "node bin/run-checks.mjs --tier release",
    "check:syntax": "node --check bin/silvermoon.js",
    "check:pure": "node bin/pure-check.mjs",
    "check:staged": "node bin/silvermoon.js check --staged --audience agent",
    "check:diff": "git diff --check && git diff --cached --check",
    "check:quick": "node --check bin/silvermoon.js && npm test",
    "check:skills": "npm run check:skills:local && npm run check:skills:discover",
    "check:skills:local": "node bin/sync-skills.mjs --check",
    "check:skills:discover": "npx skills add . --list",
    "lint:markdown": "markdownlint-cli2",
    "pack:check": "node bin/check-pack.js",
    "prepare:npm-release": "node bin/prepare-npm-release.mjs",
    "sync:skills": "node bin/sync-skills.mjs",
    "test": "npm run test:unit && npm run test:contract",
    "test:contract": "node --test \"test/contract/*.test.*\"",
    "test:e2e": "node --test \"test/e2e/*.test.*\"",
    "test:integration": "node --test \"test/integration/*.test.*\"",
    "test:sanity": "node --import ./test/helpers/sanity-guard.mjs --test \"test/unit/*.test.*\" test/contract/schema-v1.test.js test/contract/schema-v2.test.js test/contract/package-api.test.js",
    "test:smoke": "node --test test/runtime/adoption.test.js test/runtime/cli-v1.test.js",
    "test:unit": "node --test \"test/unit/*.test.*\" \"test/runtime/*.test.*\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent-skills",
    "cli",
    "project-state",
    "repository",
    "validation",
    "whats-next"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/silvermoon.git"
  },
  "homepage": "https://github.com/shazhou-ww/silvermoon#readme",
  "bugs": {
    "url": "https://github.com/shazhou-ww/silvermoon/issues"
  },
  "author": {
    "name": "shazhou-ww",
    "url": "https://github.com/shazhou-ww"
  },
  "contributors": [
    {
      "name": "shazhou-ww",
      "url": "https://github.com/shazhou-ww"
    }
  ],
  "maintainers": [
    {
      "name": "shazhou-ww",
      "url": "https://github.com/shazhou-ww"
    }
  ],
  "devDependencies": {
    "ajv": "^8.20.0",
    "markdownlint-cli2": "^0.23.3",
    "semver": "^7.8.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.16",
    "@opentui/core": "npm:@jitl/opentui-core@0.4.0",
    "@opentui/react": "npm:@jitl/opentui-react@0.4.0",
    "commander": "^14.0.3",
    "marked": "^18.0.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "react": "^19.3.0",
    "react-devtools-core": "^7.0.1",
    "string-width": "^8.3.0",
    "tui-md": "^0.2.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
