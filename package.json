{
  "name": "silvermoon",
  "version": "0.4.0",
  "description": "The project spirit that checks repository state and answers what's next.",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "silvermoon": "dist/bin/silvermoon.js",
    "silvermoon-link-skill": "dist/bin/link-personal-skill.js",
    "silvermoon-migrate-v1-to-v2": "dist/bin/migrate-v1-to-v2.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./agents/copilot": {
      "types": "./dist/src/business/agent-copilot.d.ts",
      "default": "./dist/src/business/agent-copilot.js"
    },
    "./agents/project-runtime": {
      "types": "./dist/src/business/agent-project-runtime.d.ts",
      "default": "./dist/src/business/agent-project-runtime.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "skills/silvermoon",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "schema"
  ],
  "scripts": {
    "clean": "node tools/clean.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.build.json && node tools/write-cli-shim.ts",
    "link:runtime": "npm run build && npm link",
    "link:skill": "node bin/link-personal-skill.ts",
    "setup:dev": "npm run link:runtime && npm run link:skill",
    "check": "node bin/run-checks.ts",
    "check:sanity": "node bin/run-checks.ts --tier sanity",
    "check:commit": "node bin/run-checks.ts --tier commit",
    "check:release": "node bin/run-checks.ts --tier release",
    "check:syntax": "node --check bin/silvermoon.ts",
    "check:pure": "node bin/pure-check.ts",
    "check:staged": "node bin/silvermoon.ts check --staged --audience agent",
    "check:diff": "git diff --check && git diff --cached --check",
    "check:quick": "npm run check:syntax && npm test",
    "check:skills": "npm run check:skills:discover",
    "check:skills:discover": "npx skills add . --list",
    "lint:markdown": "markdownlint-cli2",
    "pack:check": "npm run build && npm run pack:check:built",
    "pack:check:built": "node bin/check-pack.ts",
    "prepare:npm-release": "node bin/prepare-npm-release.ts",
    "test": "npm run test:unit && npm run test:contract",
    "test:contract": "npm run build && npm run test:contract:built",
    "test:contract:built": "node --test \"test/contract/*.test.ts\"",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "node --test \"test/e2e/*.test.ts\"",
    "test:integration": "npm run build && npm run test:integration:built",
    "test:integration:built": "node --test \"test/integration/*.test.ts\"",
    "test:integration:extended": "npm run build && npm run test:integration:extended:built",
    "test:integration:extended:built": "node --test \"test/integration-extended/*.test.ts\"",
    "test:integration:all": "npm run build && npm run test:integration:all:built",
    "test:integration:all:built": "node --test \"test/integration/*.test.ts\" \"test/integration-extended/*.test.ts\"",
    "test:integration:platform": "npm run build && npm run test:integration:platform:built",
    "test:integration:platform:built": "node --test --test-name-pattern=\"reused snapshot index avoids reading unchanged bodies|authenticated native timestamps|unauthenticated native source records|real CLI preserves a small event stream\" test/integration/git.test.ts test/integration-extended/incremental-append.test.ts",
    "test:integration:live": "npm run build && npm run test:integration:live:built",
    "test:integration:live:built": "node --test \"test/integration-live/*.test.ts\"",
    "test:sanity": "node --import ./test/helpers/sanity-guard.ts --test \"test/unit/*.test.ts\" test/contract/schema-v1.test.ts test/contract/schema-v2.test.ts test/contract/package-api.test.ts",
    "test:smoke": "node --test test/runtime/adoption.test.ts test/runtime/cli-v1.test.ts",
    "test:unit": "node --test \"test/unit/*.test.ts\" \"test/runtime/*.test.ts\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "agent-skills",
    "cli",
    "project-state",
    "repository",
    "validation",
    "whats-next"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/silvermoon.git"
  },
  "homepage": "https://github.com/shazhou-ww/silvermoon#readme",
  "bugs": {
    "url": "https://github.com/shazhou-ww/silvermoon/issues"
  },
  "author": {
    "name": "shazhou-ww",
    "url": "https://github.com/shazhou-ww"
  },
  "contributors": [
    {
      "name": "shazhou-ww",
      "url": "https://github.com/shazhou-ww"
    }
  ],
  "maintainers": [
    {
      "name": "shazhou-ww",
      "url": "https://github.com/shazhou-ww"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "markdownlint-cli2": "^0.23.3",
    "semver": "^7.8.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.16",
    "@opentui/core": "npm:@jitl/opentui-core@0.4.0",
    "@opentui/react": "npm:@jitl/opentui-react@0.4.0",
    "commander": "^15.0.0",
    "marked": "^18.0.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "react": "^19.3.0",
    "react-devtools-core": "^7.0.1",
    "string-width": "^8.3.0",
    "tui-md": "^0.2.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
