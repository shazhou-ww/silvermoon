{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shazhou-ww/silvermoon/raw/refs/heads/main/schema/capability-manifest.schema.json",
  "title": "Silvermoon schema capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "releaseBoundary", "families"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "releaseBoundary": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "families": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "pathPatterns",
        "targetVersion",
        "readVersions",
        "schemas",
        "migrations"
      ],
      "properties": {
        "scope": { "enum": ["project", "device", "runtime"] },
        "pathPatterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "targetVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "readVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "schemas": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[1-9][0-9]*$": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "migrations": {
          "type": "array",
          "items": { "$ref": "#/$defs/migration" }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromVersion", "toVersion", "entrypoint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "fromVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "toVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    }
  }
}
