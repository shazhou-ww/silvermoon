{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shazhou-ww/silvermoon/raw/refs/heads/main/schema/v1/command-report.schema.json",
  "title": "Silvermoon command report v1",
  "description": "The four public projections returned by every trustworthy Silvermoon command.",
  "$defs": {
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "owner",
        "level",
        "failingCheck",
        "terminal",
        "problems",
        "references"
      ],
      "properties": {
        "target": {
          "enum": ["device", "project", "idea"]
        },
        "owner": {
          "enum": ["device", "project", "idea"]
        },
        "level": {
          "type": "string",
          "minLength": 1
        },
        "failingCheck": {
          "type": ["string", "null"]
        },
        "terminal": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "parameters"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "object"
              }
            }
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "title", "command"],
            "properties": {
              "kind": {
                "enum": ["level", "check", "problem"]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intention",
    "observation",
    "actions",
    "response"
  ],
  "properties": {
    "intention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "args"
      ],
      "properties": {
        "command": {
          "enum": [
            "whats-next",
            "create-idea",
            "check",
            "list-ideas",
            "event"
          ]
        },
        "args": {
          "type": "object"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "state",
        "problems"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "problems": {
          "type": "array"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^action-[1-9][0-9]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "success",
              "failure"
            ]
          },
          "result": {
            "type": "object"
          },
          "problem": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "success"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "type": "object"
                }
              },
              "required": [
                "result"
              ]
            },
            "else": {
              "properties": {
                "problem": {
                  "type": "object"
                }
              },
              "required": [
                "problem"
              ]
            }
          }
        ]
      }
    },
    "response": {
      "type": "object",
      "required": [
        "kind",
        "language",
        "summary"
      ],
      "properties": {
        "kind": {
          "enum": [
            "blocked",
            "choice-required",
            "idea-created",
            "idea-list",
            "next-steps",
            "objective",
            "validation-result",
            "event-result"
          ]
        },
        "language": {
          "enum": [
            "en-US",
            "zh-CN"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "nextSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
